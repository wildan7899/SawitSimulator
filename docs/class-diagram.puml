@startuml SawitManagementSystemClassDiagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

title UML Class Diagram - Sistem Manajemen Perkebunan Kelapa Sawit

interface Perawatan {
  + jadwalkanPemupukan(): String
  + jadwalkanPenyiraman(): String
}

abstract class TanamanSawit {
  - idTanaman: String
  - tanggalTanam: LocalDate
  - luasLahan: double
  - lokasiLahan: String
  + getUmurBulan(): long
  + getIdTanaman(): String
  + setIdTanaman(idTanaman: String): void
  + getTanggalTanam(): LocalDate
  + setTanggalTanam(tanggalTanam: LocalDate): void
  + getLuasLahan(): double
  + setLuasLahan(luasLahan: double): void
  + getLokasiLahan(): String
  + setLokasiLahan(lokasiLahan: String): void
  + {abstract} hitungEstimasiPanen(): double
  + {abstract} getStatusPertumbuhan(): String
  + {abstract} hitungKebutuhanPupuk(): double
  + {abstract} getJenisFase(): String
  + {abstract} getParameterKhusus(): double
  + {abstract} getKeteranganEstimasi(): String
}

class SawitMuda {
  - DOSIS_PUPUK_KG_PER_HA: double = 350.0
  - tinggiRataRataCm: double
  + getTinggiRataRataCm(): double
  + setTinggiRataRataCm(tinggiRataRataCm: double): void
  + hitungEstimasiPanen(): double
  + getStatusPertumbuhan(): String
  + hitungKebutuhanPupuk(): double
  + jadwalkanPemupukan(): String
  + jadwalkanPenyiraman(): String
}

class SawitProduktif {
  - DOSIS_PUPUK_KG_PER_HA: double = 650.0
  - targetTonPerHa: double
  + getTargetTonPerHa(): double
  + setTargetTonPerHa(targetTonPerHa: double): void
  - getFaktorUmur(): double
  + hitungEstimasiPanen(): double
  + getStatusPertumbuhan(): String
  + hitungKebutuhanPupuk(): double
  + jadwalkanPemupukan(): String
  + jadwalkanPenyiraman(): String
}

class RiwayatPerawatan {
  - idRiwayat: String
  - idTanaman: String
  - tanggal: LocalDate
  - jenisKegiatan: String
  - keterangan: String
  + getIdRiwayat(): String
  + getIdTanaman(): String
  + getTanggal(): LocalDate
  + getJenisKegiatan(): String
  + getKeterangan(): String
}

class ManajemenSawit {
  - daftarTanaman: List<TanamanSawit>
  - daftarRiwayat: List<RiwayatPerawatan>
  - penyimpanan: PenyimpananData
  + muatData(buatDataAwalJikaKosong: boolean): void
  + simpanData(): void
  + tambahTanaman(tanaman: TanamanSawit): void
  + updateTanaman(idLama: String, tanamanBaru: TanamanSawit): void
  + hapusTanaman(idTanaman: String): boolean
  + cariTanaman(keyword: String): List<TanamanSawit>
  + catatPerawatan(idTanaman: String, tanggal: LocalDate, jenis: String, ket: String): RiwayatPerawatan
  + getTotalEstimasiPanen(): double
  + getTotalKebutuhanPupuk(): double
}

class PenyimpananData {
  - fileTanaman: Path
  - fileRiwayat: Path
  + simpanTanaman(daftarTanaman: List<TanamanSawit>): void
  + muatTanaman(): HasilMuat<TanamanSawit>
  + simpanRiwayat(daftarRiwayat: List<RiwayatPerawatan>): void
  + muatRiwayat(): HasilMuat<RiwayatPerawatan>
}

class MainFrame {
  - manajemen: ManajemenSawit
  - dashboardPanel: DashboardPanel
  - tanamanPanel: TanamanPanel
  - perawatanPanel: PerawatanPanel
  - panenPanel: PanenPanel
  + tampilkanHalaman(namaHalaman: String): void
  + refreshSemuaPanel(): void
}

Perawatan <|.. TanamanSawit
TanamanSawit <|-- SawitMuda
TanamanSawit <|-- SawitProduktif

ManajemenSawit o--> "0..*" TanamanSawit : mengelola
ManajemenSawit o--> "0..*" RiwayatPerawatan : mencatat
ManajemenSawit --> "1" PenyimpananData : menyimpan
MainFrame --> "1" ManajemenSawit : menggunakan

@enduml
