@startuml SawitFarmClassDiagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

title Class Diagram - Sawit Farm (Mini Farming Game OOP)

interface BisaDirawat {
  + siram(): void
  + beriPupuk(): void
}

abstract class TanamanSawit {
  - umur: int
  - air: int
  - pupuk: int
  + siram(): void
  + beriPupuk(): void
  + {abstract} tumbuh(): void
  + {abstract} getStatus(): String
  + {abstract} getSimbol(): String
  + cekEvolusi(): TanamanSawit
  + isSiapPanen(): boolean
  + panen(): int
  + getUmur(): int
  + getAir(): int
  + getPupuk(): int
}

class BibitSawit {
  + tumbuh(): void
  + cekEvolusi(): TanamanSawit
  + getStatus(): String
  + getSimbol(): String
}

class SawitMuda {
  + tumbuh(): void
  + cekEvolusi(): TanamanSawit
  + getStatus(): String
  + getSimbol(): String
}

class SawitDewasa {
  - progresBuah: int
  - siapPanen: boolean
  + tumbuh(): void
  + isSiapPanen(): boolean
  + panen(): int
  + getStatus(): String
  + getSimbol(): String
}

class GameSawit {
  - lahan: TanamanSawit[][]
  - koin: int
  - hari: int
  - totalPanen: int
  + tanam(baris: int, kolom: int): String
  + siram(baris: int, kolom: int): String
  + beriPupuk(baris: int, kolom: int): String
  + hariBerikutnya(): String
  + panen(baris: int, kolom: int): String
  + getBibitTersedia(): int
}

class GameGUI {
  - game: GameSawit
  - petakGrid: PetakPanel[][]
  - barisTerpilih: int
  - kolomTerpilih: int
  + pilihPetak(baris: int, kolom: int): void
  + perbaruiTampilan(): void
}

BisaDirawat <|.. TanamanSawit
TanamanSawit <|-- BibitSawit
TanamanSawit <|-- SawitMuda
TanamanSawit <|-- SawitDewasa
GameSawit o--> "0..16" TanamanSawit : mengelola
GameGUI --> "1" GameSawit : memainkan

@enduml
